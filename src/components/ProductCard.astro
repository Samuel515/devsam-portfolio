---
import type { Project } from "@/data/site";

interface Props {
  project: Project;
  index: number;
}
const { project: p, index } = Astro.props;
const flip = index % 2 === 1;
const num = String(index + 1).padStart(2, "0");
---

<article class="reveal card group overflow-hidden p-3 sm:p-4">
  <div class:list={["grid items-start gap-6 lg:grid-cols-12 lg:gap-10", flip && "lg:[&>*:first-child]:order-2"]}>
    <a
      href={p.url}
      target="_blank"
      rel="noopener"
      class="frame block lg:sticky lg:top-24 lg:col-span-7"
      aria-label={`Visit ${p.name} (opens in a new tab)`}
    >
      <div class="flex items-center gap-1.5 border-b border-line px-3 py-2.5" aria-hidden="true">
        <span class="size-2.5 rounded-full bg-line-strong"></span>
        <span class="size-2.5 rounded-full bg-line-strong"></span>
        <span class="size-2.5 rounded-full bg-line-strong"></span>
        <span class="ml-3 truncate font-mono text-[11px] text-subtle">{p.urlLabel}</span>
      </div>
      <img
        src={p.image}
        alt={`Homepage of ${p.name}`}
        width="1440"
        height="900"
        loading={index === 0 ? "eager" : "lazy"}
        decoding="async"
        class="aspect-[16/10] w-full object-cover object-top"
      />
    </a>

    <div class="px-2 pb-4 sm:px-3 lg:col-span-5 lg:py-6">
      <div class="flex items-center gap-3">
        <span class="font-mono text-xs text-accent">{num}</span>
        <span class="h-px flex-1 bg-line"></span>
        <span class="label">{p.role}{p.period && ` · ${p.period}`}</span>
      </div>

      <h3 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">{p.name}</h3>
      <p class="mt-3 text-base leading-relaxed text-muted text-pretty">{p.summary}</p>

      <ul class="mt-6 space-y-3">
        {
          p.highlights.map((h) => (
            <li class="flex gap-3 text-sm leading-relaxed text-muted">
              <span class="mt-2 size-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              <span>{h}</span>
            </li>
          ))
        }
      </ul>

      <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tech stack">
        {p.stack.map((s) => <li class="pill">{s}</li>)}
      </ul>

      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
        <a href={p.url} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-fg">
          <span class="link-underline">Visit {p.urlLabel}</span>
          <svg class="size-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
        </a>
        {
          p.extraLink && (
            <a href={p.extraLink.url} target="_blank" rel="noopener" class="text-muted hover:text-fg">
              <span class="link-underline">{p.extraLink.label}</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>
