---
import SectionHeader from "./SectionHeader.astro";
import { tools, toolsRepo } from "@/data/site";
---

<section id="tools" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeader
      index="03"
      label="Open-source tools"
      title="Free tools that never see your files."
      intro="Everyday utilities I built and maintain. Everything runs in the browser with WebAssembly and Web Workers, so nothing is uploaded and there's no server to run."
    />

    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((t, i) => (
          <li class="reveal" style={`--delay: ${(i % 3) * 60}ms`}>
            <a href={t.url} target="_blank" rel="noopener" class="card group flex h-full items-start gap-4 p-5">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-xl font-mono text-[11px] font-bold"
                style={`background: oklch(0.8 0.15 ${t.hue} / 0.14); color: oklch(0.72 0.16 ${t.hue}); box-shadow: inset 0 0 0 1px oklch(0.8 0.15 ${t.hue} / 0.3);`}
                aria-hidden="true"
              >
                {t.glyph}
              </span>
              <span class="min-w-0">
                <span class="flex items-center gap-1.5 font-medium tracking-tight">
                  {t.name}
                  <svg class="size-3.5 text-subtle transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7M8 7h9v9" />
                  </svg>
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-muted">{t.tagline}</span>
                <span class="mt-2 block font-mono text-[11px] text-subtle">{t.url.replace("https://", "")}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-8 text-sm text-muted">
      All MIT licensed.
      <a href={toolsRepo} target="_blank" rel="noopener" class="link-underline text-fg">View the source on GitHub</a>
    </p>
  </div>
</section>
