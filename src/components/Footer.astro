---
import { person, toolsRepo } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-8 font-mono text-xs text-subtle sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p>© {year} {person.name}</p>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-4 gap-y-2">
      <a href="/tools/" class="transition-colors hover:text-fg">Tools</a>
      <a href="/tools/privacy/" class="transition-colors hover:text-fg">Privacy</a>
      <a href={toolsRepo} target="_blank" rel="noopener" class="transition-colors hover:text-fg">GitHub</a>
    </nav>
  </div>
</footer>
