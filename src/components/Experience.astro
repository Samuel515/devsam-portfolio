---
import SectionHeader from "./SectionHeader.astro";
import { experience, education } from "@/data/site";
---

<section id="experience" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeader index="05" label="Experience" title="Where I've worked and studied." />

    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h3 class="reveal label mb-4">Experience</h3>
        <ol class="border-t border-line">
          {
            experience.map((e, i) => (
              <li
                class="reveal grid gap-1 border-b border-line py-6 sm:grid-cols-[1fr_auto] sm:gap-6"
                style={`--delay: ${i * 60}ms`}
              >
                <div>
                  <p class="text-lg font-medium tracking-tight">{e.role}</p>
                  <p class="text-muted">{e.org}</p>
                  {e.detail && <p class="mt-3 max-w-lg text-sm leading-relaxed text-subtle">{e.detail}</p>}
                </div>
                <p class="font-mono text-xs text-subtle sm:pt-1.5">{e.period}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="lg:col-span-5">
        <h3 class="reveal label mb-4">Education & certifications</h3>
        <ol class="border-t border-line">
          {
            education.map((e, i) => (
              <li
                class="reveal flex items-baseline justify-between gap-6 border-b border-line py-6"
                style={`--delay: ${i * 60}ms`}
              >
                <div>
                  <p class="font-medium tracking-tight">{e.title}</p>
                  <p class="text-sm text-muted">{e.org}</p>
                </div>
                {e.period && <p class="font-mono text-xs text-subtle">{e.period}</p>}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
