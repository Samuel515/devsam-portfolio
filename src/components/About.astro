---
import { Picture } from "astro:assets";
import portrait from "@/assets/samuel-ogbodo.jpeg";
import SectionHeader from "./SectionHeader.astro";
import { person, skills } from "@/data/site";
---

<section id="about" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeader index="04" label="About" title="An engineer who owns the whole product." />

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <figure class="reveal mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
        <div class="card overflow-hidden p-2">
          <Picture
            src={portrait}
            formats={["avif", "webp"]}
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 420px, 100vw"
            alt={`Portrait of ${person.name}`}
            class="aspect-[4/5] w-full rounded-[0.9rem] object-cover object-[50%_30%]"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-4 flex items-center justify-between font-mono text-xs text-subtle">
          <span>{person.name}</span>
          <span>{person.location}</span>
        </figcaption>
      </figure>

      <div class="lg:col-span-7">
        <div class="reveal space-y-5 text-lg leading-relaxed text-muted text-pretty">
          <p>
            I'm a fullstack engineer and computer science graduate based in Nigeria. In 2025 I co-founded{" "}
            <span class="text-fg">VerityWave Innovations</span>, where I'm CTO. We build tools that detect and verify
            AI-generated content, along with products like VeriPay and ALIDU that depend on that same trust.
          </p>
          <p>
            My work runs across frontend, backend, UI/UX and deployment, and I usually have several products in flight at
            once. I'm as comfortable designing an interface as I am planning GPU infrastructure, writing a payment state
            machine or configuring DNS. I've also worked in Web3.
          </p>
          <p>
            What I care about most is software people can rely on: clear architecture, fast pages, careful security and
            interfaces that feel considered.
          </p>
        </div>

        <div class="reveal mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
          {
            skills.map((s) => (
              <div class="bg-bg p-5">
                <h3 class="label">{s.group}</h3>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {s.items.map((i) => (
                    <li class="pill">{i}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
