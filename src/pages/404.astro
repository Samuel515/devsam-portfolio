---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { tools } from "@/data/site";

const suggestions = [
  { href: "/?work", label: "Products I lead" },
  { href: "/?clients", label: "Client work" },
  { href: "/?tools", label: "Open-source tools" },
  { href: "/?contact", label: "Get in touch" },
];
---

<Base title="Page not found · Samuel Ogbodo" description="This page doesn't exist." noindex>
  <Nav />
  <main id="main" class="relative overflow-hidden">
    <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="glow pointer-events-none absolute -top-40 left-1/2 h-[520px] w-[900px] -translate-x-1/2" aria-hidden="true"></div>

    <section class="relative mx-auto flex min-h-[78dvh] max-w-6xl flex-col justify-center px-5 pt-32 pb-20 sm:px-8">
      <p class="label"><span class="text-accent">404</span> / Not found</p>
      <h1 class="mt-4 max-w-3xl text-[clamp(2.5rem,7vw,5rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance">
        This page doesn't exist.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        The link may be broken, or the page may have moved. Here's where you can go instead.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-3 text-sm font-medium text-accent-fg transition-transform hover:-translate-y-0.5">
          Back to the homepage
        </a>
        {
          suggestions.map((s) => (
            <a href={s.href} class="inline-flex items-center rounded-xl border border-line-strong px-5 py-3 text-sm font-medium transition-colors hover:bg-hover">
              {s.label}
            </a>
          ))
        }
      </div>

      <div class="mt-16">
        <p class="label mb-4">Looking for a tool?</p>
        <ul class="flex flex-wrap gap-2">
          {
            tools.map((t) => (
              <li>
                <a href={t.url} class="pill transition-colors hover:border-line-strong hover:text-fg">
                  {t.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>
