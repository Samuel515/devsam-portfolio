// Cloudflare Worker that serves the static portfolio build.
// The custom domain (devsamc.xyz) is managed in the Cloudflare dashboard.
{
  "name": "devsam-portfolio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
